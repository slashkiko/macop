{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "7 days",
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "enabledManagers": [
    "github-actions",
    "swift",
    "regex"
  ],
  "regexManagers": [
    {
      "fileMatch": [
        "^\\.mise\\.toml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[a-z0-9_-]+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
        "swift",
        "regex"
      ],
      "minimumReleaseAge": "7 days"
    }
  ]
}
